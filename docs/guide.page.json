            {
              "type": "section",
              "title": "▶️ 手元で動かす",
              "blocks": [
                {
                  "type": "card",
                  "title": "🖼 Image Studio",
                  "text": "図形・画像・スタンプを重ね、PNG・SVG・Base64・再編集できる JSON で出します。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "python -S image_studio.py"
                    }
                  ]
                },
                {
                  "type": "card",
                  "title": "📦 静的サイトを組む",
                  "text": "道具一式を相対パスのフォルダに書き出します（ポートフォリオはこれを公開時に呼びます）。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "python -S image_studio.py --build-site DIR"
                    }
                  ]
                },
                {
                  "type": "card",
                  "title": "📝 Markdown → PPTX",
                  "text": "Marp CLI を使って Markdown から PPTX を作ります。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "python pptx_pipeline.py slides.md -o slides.pptx"
                    }
                  ]
                },
                {
                  "type": "card",
                  "title": "🎨 PPTX の属性を置き換え",
                  "text": "既存の PPTX の文字・色・フォントを置き換えます（--dry-run で確認だけ）。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "python pptx_replace.py --help"
                    }
                  ]
                }
              ]
            }
          ]
        }
